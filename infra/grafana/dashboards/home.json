    {
      "id": 201,
      "type": "table",
      "title": "Vendor Drift",
      "description": "Top vendors detected last 7d. Vendors not in learned_anchors (null before first retrain) are flagged as drifted. Renders empty before first retrain.",
      "datasource": {
        "type": "postgres",
        "uid": "invoicex-db"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#a6e3a1",
                "value": null
              },
              {
                "color": "#f38ba8",
                "value": 1
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "drifted"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "true": {
                        "color": "#f38ba8",
                        "text": "NEW"
                      },
                      "false": {
                        "color": "#a6e3a1",
                        "text": "known"
                      }
                    },
                    "type": "value"
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "invoicex-db"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH anchors AS (\n  SELECT COALESCE(payload->'learned_anchors', '[]'::jsonb) AS la\n  FROM contract_schema\n  ORDER BY version DESC LIMIT 1\n),\nvendors AS (\n  SELECT\n    e.payload->'candidates'->0->>'raw_text' AS vendor,\n    COUNT(*) AS occurrences\n  FROM doc_evaluations e\n  WHERE e.field = 'vendor'\n    AND e.created_at > NOW() - INTERVAL '7 days'\n    AND e.payload->'candidates'->0->>'raw_text' IS NOT NULL\n  GROUP BY 1\n  ORDER BY 2 DESC\n  LIMIT 20\n)\nSELECT\n  v.vendor,\n  v.occurrences,\n  NOT (SELECT la @> to_json(v.vendor)::jsonb FROM anchors) AS drifted\nFROM vendors v",
          "refId": "A"
        }
      ]
    },
    {
      "id": 202,
      "type": "barchart",
      "title": "Field Confidence Distribution",
      "description": "Average priority_score per field from doc_evaluations (top-level payload key written by handle_reextract).",
      "datasource": {
        "type": "postgres",
        "uid": "invoicex-db"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "options": {
        "barRadius": 0.05,
        "barWidth": 0.8,
        "groupWidth": 0.7,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "orientation": "horizontal",
        "tooltip": {
          "mode": "single",
          "sort": "desc"
        },
        "xTickLabelRotation": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "#cba6f7",
            "mode": "fixed"
          },
          "unit": "short",
          "decimals": 2
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "invoicex-db"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  e.field,\n  ROUND(AVG((e.payload->>'priority_score')::float)::numeric, 3) AS avg_confidence,\n  COUNT(*) AS evaluations\nFROM doc_evaluations e\nWHERE (e.payload->>'priority_score') IS NOT NULL\nGROUP BY e.field\nORDER BY avg_confidence DESC",
          "refId": "A"
        }
      ]
    },
