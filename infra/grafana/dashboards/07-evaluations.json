      "pluginVersion": "10.2.0",
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "invoicex-db"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT e.doc_id, e.field, COALESCE((e.payload->>'priority_score')::float, 0) AS priority_score, CASE WHEN (e.payload->>'priority_score')::float >= 0.8 THEN 'urgent' WHEN (e.payload->>'priority_score')::float >= 0.5 THEN 'medium' ELSE 'low' END AS priority_bucket, COALESCE(e.payload->>'reason', '') AS reason, e.evaluator_version, COALESCE((e.payload->>'signal_disagreement')::boolean, false) AS signal_disagreement, COALESCE((e.payload->>'used_ml_model')::boolean, false) AS used_ml_model, e.created_at FROM doc_evaluations e ORDER BY e.created_at DESC LIMIT 50",
          "refId": "A"
        }
      ],
      "title": "Recent Evaluations",
      "type": "table"
    }
