        "content": "<div style=\"display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px;\">\n  <div style=\"background: #e3f2fd; padding: 16px; border-radius: 8px; text-align: center;\">\n    <div style=\"font-size: 24px; margin-bottom: 8px;\">CHECK</div>\n    <div style=\"font-weight: 600; color: #1565C0;\">Correct</div>\n    <div style=\"font-size: 13px; color: #666; margin-top: 4px;\">Click when the extracted value matches the document</div>\n  </div>\n  <div style=\"background: #ffebee; padding: 16px; border-radius: 8px; text-align: center;\">\n    <div style=\"font-size: 24px; margin-bottom: 8px;\">X</div>\n    <div style=\"font-weight: 600; color: #C62828;\">Wrong</div>\n    <div style=\"font-size: 13px; color: #666; margin-top: 4px;\">Click and enter the correct value</div>\n  </div>\n  <div style=\"background: #fff3e0; padding: 16px; border-radius: 8px; text-align: center;\">\n    <div style=\"font-size: 24px; margin-bottom: 8px;\">?</div>\n    <div style=\"font-weight: 600; color: #E65100;\">Uncertain</div>\n    <div style=\"font-size: 13px; color: #666; margin-top: 4px;\">Orange fields need extra attention</div>\n  </div>\n  <div style=\"background: #f3e5f5; padding: 16px; border-radius: 8px; text-align: center;\">\n    <div style=\"font-size: 24px; margin-bottom: 8px;\">SKIP</div>\n    <div style=\"font-weight: 600; color: #7B1FA2;\">Skip</div>\n    <div style=\"font-size: 13px; color: #666; margin-top: 4px;\">Use for unreadable or problematic documents</div>\n  </div>\n</div>",
