        "content": "<div style=\"background: white; border-radius: 8px; height: 100%; display: flex; flex-direction: column; border: 1px solid #dee2e6;\">\n  <div style=\"padding: 16px 20px; background: #f8f9fa; border-bottom: 1px solid #dee2e6; border-radius: 8px 8px 0 0;\">\n    <h3 style=\"margin: 0; color: #1a237e; font-size: 18px;\">Extracted Fields</h3>\n    <p style=\"margin: 4px 0 0 0; color: #666; font-size: 13px;\">Review each field and mark as correct or provide corrections</p>\n  </div>\n  \n  <div style=\"flex: 1; overflow-y: auto; padding: 16px;\">\n    <!-- Field: Invoice Number -->\n    <div style=\"margin-bottom: 16px; padding: 16px; background: #e8f5e9; border-radius: 8px; border-left: 4px solid #4CAF50;\">\n      <div style=\"display: flex; justify-content: space-between; align-items: flex-start;\">\n        <div>\n          <div style=\"font-size: 12px; color: #666; text-transform: uppercase; letter-spacing: 0.5px;\">Invoice Number</div>\n          <div style=\"font-size: 18px; font-weight: 600; color: #1a237e; margin-top: 4px;\">INV-2024-00123</div>\n          <div style=\"font-size: 12px; color: #4CAF50; margin-top: 4px;\">Confidence: 98%</div>\n        </div>\n        <div style=\"display: flex; gap: 8px;\">\n          <button style=\"background: #4CAF50; color: white; border: none; padding: 8px 16px; border-radius: 6px; cursor: pointer; font-weight: 500;\">Correct</button>\n          <button style=\"background: white; color: #F44336; border: 2px solid #F44336; padding: 8px 16px; border-radius: 6px; cursor: pointer; font-weight: 500;\">Wrong</button>\n        </div>\n      </div>\n    </div>\n    \n    <!-- Field: Invoice Date -->\n    <div style=\"margin-bottom: 16px; padding: 16px; background: #e8f5e9; border-radius: 8px; border-left: 4px solid #4CAF50;\">\n      <div style=\"display: flex; justify-content: space-between; align-items: flex-start;\">\n        <div>\n          <div style=\"font-size: 12px; color: #666; text-transform: uppercase; letter-spacing: 0.5px;\">Invoice Date</div>\n          <div style=\"font-size: 18px; font-weight: 600; color: #1a237e; margin-top: 4px;\">2024-01-15</div>\n          <div style=\"font-size: 12px; color: #4CAF50; margin-top: 4px;\">Confidence: 95%</div>\n        </div>\n        <div style=\"display: flex; gap: 8px;\">\n          <button style=\"background: #4CAF50; color: white; border: none; padding: 8px 16px; border-radius: 6px; cursor: pointer; font-weight: 500;\">Correct</button>\n          <button style=\"background: white; color: #F44336; border: 2px solid #F44336; padding: 8px 16px; border-radius: 6px; cursor: pointer; font-weight: 500;\">Wrong</button>\n        </div>\n      </div>\n    </div>\n    \n    <!-- Field: Total Amount (Low Confidence) -->\n    <div style=\"margin-bottom: 16px; padding: 16px; background: #fff3e0; border-radius: 8px; border-left: 4px solid #FF9800;\">\n      <div style=\"display: flex; justify-content: space-between; align-items: flex-start;\">\n        <div>\n          <div style=\"font-size: 12px; color: #666; text-transform: uppercase; letter-spacing: 0.5px;\">Total Amount</div>\n          <div style=\"font-size: 18px; font-weight: 600; color: #1a237e; margin-top: 4px;\">$1,978.90</div>\n          <div style=\"font-size: 12px; color: #FF9800; margin-top: 4px;\">Confidence: 72% - Needs Review</div>\n        </div>\n        <div style=\"display: flex; gap: 8px;\">\n          <button style=\"background: #4CAF50; color: white; border: none; padding: 8px 16px; border-radius: 6px; cursor: pointer; font-weight: 500;\">Correct</button>\n          <button style=\"background: white; color: #F44336; border: 2px solid #F44336; padding: 8px 16px; border-radius: 6px; cursor: pointer; font-weight: 500;\">Wrong</button>\n        </div>\n      </div>\n      <div style=\"margin-top: 12px;\">\n        <input type=\"text\" placeholder=\"Enter correct value if wrong...\" style=\"width: 100%; padding: 10px 12px; border: 1px solid #ddd; border-radius: 6px; font-size: 14px;\" />\n      </div>\n    </div>\n    \n    <!-- Field: Vendor Name -->\n    <div style=\"margin-bottom: 16px; padding: 16px; background: #e8f5e9; border-radius: 8px; border-left: 4px solid #4CAF50;\">\n      <div style=\"display: flex; justify-content: space-between; align-items: flex-start;\">\n        <div>\n          <div style=\"font-size: 12px; color: #666; text-transform: uppercase; letter-spacing: 0.5px;\">Vendor Name</div>\n          <div style=\"font-size: 18px; font-weight: 600; color: #1a237e; margin-top: 4px;\">Acme Corporation</div>\n          <div style=\"font-size: 12px; color: #4CAF50; margin-top: 4px;\">Confidence: 92%</div>\n        </div>\n        <div style=\"display: flex; gap: 8px;\">\n          <button style=\"background: #4CAF50; color: white; border: none; padding: 8px 16px; border-radius: 6px; cursor: pointer; font-weight: 500;\">Correct</button>\n          <button style=\"background: white; color: #F44336; border: 2px solid #F44336; padding: 8px 16px; border-radius: 6px; cursor: pointer; font-weight: 500;\">Wrong</button>\n        </div>\n      </div>\n    </div>\n    \n    <!-- Field: Due Date (Abstain) -->\n    <div style=\"margin-bottom: 16px; padding: 16px; background: #ffebee; border-radius: 8px; border-left: 4px solid #F44336;\">\n      <div style=\"display: flex; justify-content: space-between; align-items: flex-start;\">\n        <div>\n          <div style=\"font-size: 12px; color: #666; text-transform: uppercase; letter-spacing: 0.5px;\">Due Date</div>\n          <div style=\"font-size: 18px; font-weight: 600; color: #9e9e9e; margin-top: 4px;\">Not extracted</div>\n          <div style=\"font-size: 12px; color: #F44336; margin-top: 4px;\">Status: ABSTAIN - Model uncertain</div>\n        </div>\n      </div>\n      <div style=\"margin-top: 12px;\">\n        <input type=\"text\" placeholder=\"Enter the due date from the document...\" style=\"width: 100%; padding: 10px 12px; border: 1px solid #ddd; border-radius: 6px; font-size: 14px;\" />\n      </div>\n    </div>\n    \n    <!-- More fields would follow... -->\n  </div>\n  \n  <div style=\"padding: 16px 20px; background: #f8f9fa; border-top: 1px solid #dee2e6; border-radius: 0 0 8px 8px;\">\n    <div style=\"display: flex; justify-content: space-between; align-items: center;\">\n      <div style=\"color: #666; font-size: 14px;\">\n        <span style=\"font-size: 18px; margin-right: 8px;\">HINT</span>\n        Click on a field in the document to highlight its location\n      </div>\n      <div style=\"display: flex; gap: 12px;\">\n        <button style=\"background: #e0e0e0; color: #333; border: none; padding: 12px 24px; border-radius: 8px; cursor: pointer; font-weight: 600;\">Skip Document</button>\n        <button style=\"background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; border: none; padding: 12px 32px; border-radius: 8px; cursor: pointer; font-weight: 600; font-size: 16px;\">Submit Review</button>\n      </div>\n    </div>\n  </div>\n</div>",
