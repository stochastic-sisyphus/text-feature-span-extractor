# =============================================================================
# InvoiceX Production Environment
# SECURITY: Replace ALL placeholders before deploying
# =============================================================================

# --- Environment Mode ---
# CRITICAL: production mode enforces API key requirement (401 if missing/invalid)
ENVIRONMENT=production

# --- API Documentation ---
# Enable /api/docs, /api/redoc, /api/openapi.json without API key
INVOICEX_DOCS_ENABLED=false

# --- Logging ---
INVOICEX_LOG_LEVEL=INFO
INVOICEX_LOG_FORMAT=json

# --- Postgres (shared by MLflow + Grafana) ---
# Trust auth — no password needed (Docker-internal only)
POSTGRES_USER=invoicex

# --- Grafana ---
# SECURITY: Change from defaults immediately after first login
# Generate with: openssl rand -base64 24
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# --- Grafana Azure AD SSO ---
# Azure AD app registration — redirect URI: ${INVOICEX_PUBLIC_URL}/login/azuread
# Client ID + secret set via GitHub secrets (GRAFANA_AZUREAD_CLIENT_ID, GRAFANA_AZUREAD_CLIENT_SECRET)
GF_AUTH_AZUREAD_ENABLED=false
GRAFANA_AZUREAD_CLIENT_ID=REPLACE_WITH_AZUREAD_CLIENT_ID
GRAFANA_AZUREAD_CLIENT_SECRET=REPLACE_WITH_AZUREAD_CLIENT_SECRET
GF_AUTH_DISABLE_LOGIN_FORM=false

# --- MLflow (model registry) ---
# wasbs://mlflow@<account>.blob.core.windows.net/artifacts
MLFLOW_ARTIFACT_ROOT=
INVOICEX_USE_MLFLOW=true
INVOICEX_VERSION=1.0.0
INVOICEX_MLFLOW_TRACKING_URI=http://mlflow:5000
INVOICEX_MLFLOW_EXPERIMENT_NAME=invoicex

# --- InvoiceX Pipeline Core ---
MODEL_ID=unscored-baseline
INVOICEX_CONFIDENCE_AUTO_APPROVE=0.85
INVOICEX_NONE_BIAS=0.05

# --- ML Model Settings ---
INVOICEX_USE_RANKER=false
INVOICEX_ML_SCORE_WEIGHT=0.7

# --- Candidate Generation ---
INVOICEX_TRACE_CANDIDATES=false
INVOICEX_EARLY_PAGE_BOOST=0.5
INVOICEX_EARLY_PAGE_MAX_IDX=2
INVOICEX_PRUNING_THRESHOLD=0.05
INVOICEX_PRUNING_MAX_CANDIDATES=200
INVOICEX_PRUNING_MIN_TRIGGER=50

# --- Worker Concurrency ---
INVOICEX_WORKER_CONCURRENCY=4

# --- Orchestrator Settings ---
INVOICEX_ORCHESTRATOR_MAX_RETRIES=3
INVOICEX_ORCHESTRATOR_RETRY_BASE_SECONDS=1.0
INVOICEX_ORCHESTRATOR_RETRY_MULTIPLIER=4.0
INVOICEX_ORCHESTRATOR_WATCH_INTERVAL=5.0
# INVOICEX_ORCHESTRATOR_SEED_FOLDER=  # Not used with SharePoint source

# --- Docker Volume Paths ---
# Production: mount an Azure Files share (or other durable volume) at /data.
# Local ./data is NOT durable — container restarts lose data.
DATA_PATH=./data

# --- Public URL (used for absolute URLs in API responses, CORS) ---
# Azure frontend handles TLS. Nginx serves port 80. No port suffix needed in the URL.
INVOICEX_PUBLIC_URL=http://YOUR_WIREGUARD_IP

# --- API Security ---
# CRITICAL: Generate with: openssl rand -hex 32
INVOICEX_API_KEY=REPLACE_WITH_API_KEY_64_HEX_CHARS
# CORS: Add your Grafana Cloud URL here
INVOICEX_CORS_ORIGINS=http://YOUR_WIREGUARD_IP

# --- Backend Switches (azure) ---
INVOICEX_CONNECTOR_MODE=local
INVOICEX_STORAGE_BACKEND=blob
INVOICEX_DOCUMENT_SOURCE=none
INVOICEX_OUTPUT_BACKEND=postgres
# OUTPUT_BACKEND valid values: postgres, dataverse. dataverse is validated config only, no write path in src.
# DATAVERSE_WRITE_ENABLED=true requires INVOICEX_QUALITY_GATE_BLOCKING=true (settings validator).
INVOICEX_DATAVERSE_WRITE_ENABLED=false

# --- Grafana plugin PDF proxy backend (grafana-plugins Go handler) ---
# local (default, no cloud account) | http (generic, any URL template) | sharepoint
INVOICEX_PDF_SOURCE=local
INVOICEX_PDF_LOCAL_DIR=/data/pdfs
# http backend only — placeholders: {sha}, {source_id}, {drive_id}
INVOICEX_PDF_FETCH_URL_TEMPLATE=
INVOICEX_PDF_FETCH_AUTH_HEADER=

# --- Azure Authentication ---
# DefaultAzureCredential automatically handles (in order):
#   1. EnvironmentCredential (AZURE_CLIENT_ID + AZURE_CLIENT_SECRET + AZURE_TENANT_ID)
#   2. ManagedIdentityCredential (on Container Instances / App Service)
# For managed identity on Azure: set AZURE_CLIENT_ID and AZURE_MANAGED_IDENTITY_CLIENT_ID
# to the user-assigned identity client ID. Do NOT set AZURE_CLIENT_SECRET.
AZURE_TENANT_ID=REPLACE_WITH_AZURE_TENANT_ID
AZURE_CLIENT_ID=REPLACE_WITH_AZURE_CLIENT_ID
AZURE_CLIENT_SECRET=
AZURE_MANAGED_IDENTITY_CLIENT_ID=
# Entra (Azure AD) tenant ID — used by pgqueuer worker auth and Graph API calls
ENTRA_TENANT_ID=REPLACE_WITH_ENTRA_TENANT_ID
# VM managed identity client ID (user-assigned, for worker → Azure services)
VM_MANAGED_IDENTITY_CLIENT_ID=

# --- Azure Blob Storage (when STORAGE_BACKEND=blob) ---
AZURE_STORAGE_ACCOUNT_NAME=REPLACE_WITH_STORAGE_ACCOUNT_NAME
AZURE_STORAGE_CONTAINER_NAME=invoicex
AZURE_STORAGE_CONNECTION_STRING=REPLACE_WITH_CONNECTION_STRING

# --- SharePoint (when DOCUMENT_SOURCE=sharepoint) ---
# Uses Microsoft Graph API with azure-identity for auth.
# Auth path A: Pre-resolved GUIDs (SHAREPOINT_SITE_ID + SHAREPOINT_DRIVE_ID)
# Auth path B: Runtime resolution (SHAREPOINT_HOSTNAME + SHAREPOINT_SITE_PATH)
SHAREPOINT_SITE_ID=REPLACE_WITH_SHAREPOINT_SITE_ID
SHAREPOINT_DRIVE_ID=REPLACE_WITH_SHAREPOINT_DRIVE_ID
SHAREPOINT_HOSTNAME=REPLACE_WITH_SHAREPOINT_HOSTNAME
SHAREPOINT_SITE_PATH=REPLACE_WITH_SHAREPOINT_SITE_PATH
SHAREPOINT_FOLDER=REPLACE_WITH_SHAREPOINT_FOLDER
# SharePoint folder path (relative, no leading slash)
SHAREPOINT_FOLDER_PATH=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=

# --- Dataverse (when OUTPUT_BACKEND=dataverse) ---
DATAVERSE_ENVIRONMENT_URL=REPLACE_WITH_DATAVERSE_ENVIRONMENT_URL
DATAVERSE_STAGING_TABLE=invoicex_staging
DATAVERSE_PRODUCTION_TABLE=invoicex_production

# --- Dataverse Auth (when OUTPUT_BACKEND=dataverse) ---
DATAVERSE_CLIENT_ID=
DATAVERSE_CLIENT_SECRET=

# --- Alertmanager Webhook (observability profile) ---
# OPTIONAL — if unset, alerts remain visible in the Alertmanager UI
# (http://alertmanager:9093 in the docker network) but will NOT deliver to
# an external webhook. The alertmanager-config init service logs a loud
# warning and substitutes a .invalid placeholder so alertmanager still
# starts cleanly. Set this to enable Slack/PagerDuty/HTTP receiver delivery.
# Examples:
#   Slack Incoming Webhook: https://hooks.slack.com/services/T00/B00/XXX
#   Generic HTTP receiver:  http://alert-handler.internal:8080/webhook
ALERT_WEBHOOK_URL=

# --- Container Registry (docker-compose.prod.yml) ---
REGISTRY=REPLACE_WITH_REGISTRY
IMAGE_NAME=invoicex
IMAGE_TAG=latest
